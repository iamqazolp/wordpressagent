# Copy file này thành .env rồi điền giá trị. KHÔNG commit .env.

# ── AI ───────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_BASE_URL=https://api.shopaikey.com
GEMINI_MODEL=gemini-3.8-flash

# ── Tìm kiếm (tuỳ chọn) ──────────────────────────────────────
SERP_API_KEY=

# ── Mã hoá mật khẩu website trong DB ─────────────────────────
# MẤT KHOÁ NÀY = KHÔNG GIẢI MÃ ĐƯỢC mật khẩu các website. Hãy sao lưu cùng thư mục data/.
ENCRYPTION_KEY=

# ── Chạy ứng dụng ────────────────────────────────────────────
HOST=127.0.0.1
PORT=7860
APP_OPEN_BROWSER=true

# Đăng nhập giao diện (để trống = không yêu cầu đăng nhập).
APP_USER=
APP_PASSWORD=

# Tạo link công khai gradio.live. Chỉ bật được khi đã đặt APP_USER + APP_PASSWORD
# (dùng mật khẩu mạnh; link nằm trên internet).
APP_SHARE=false
